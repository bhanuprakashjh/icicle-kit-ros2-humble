# local.conf.sample — project overrides appended after Microchip template init
#
# The Microchip template (TEMPLATECONF) sets up the base local.conf.
# setup.sh appends the block below to add ROS 2 / drone-specific settings.
#
# Key difference from the old workflow:
#   MACHINE = "mpfs-icicle-kit"  (was "icicle-kit-es" in meta-polarfire-soc-yocto-bsp)

#
# PolarFire SoC Icicle Kit — project overrides
#
MACHINE = "mpfs-icicle-kit"

#
# Parallel Build Configuration (adjust to your CPU core count)
#
BB_NUMBER_THREADS = "8"
PARALLEL_MAKE = "-j 8"

#
# Shared Download and State Cache
#
DL_DIR = "${TOPDIR}/../downloads"
SSTATE_DIR = "${TOPDIR}/../sstate-cache"

#
# Package Management
#
EXTRA_IMAGE_FEATURES += "package-management"

#
# Development & Debugging
#
IMAGE_FEATURES += "tools-debug tools-sdk dev-pkgs"

#
# Disable SPDX creation (workaround for license metadata issues)
#
INHERIT:remove = "create-spdx"
